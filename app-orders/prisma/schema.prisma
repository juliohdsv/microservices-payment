generator client {
  provider = "prisma-client"
  output   = "../src/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id         String   @id @default(uuid())
  customerId String   @unique
  amount     Int
  status     String
  createdAt  DateTime @default(now())

  @@map("orders")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  address   String
  state     String
  zipcode   String
  country   String
  dataBirth DateTime
  createdAt DateTime @default(now())

  @@map("customers")
}
